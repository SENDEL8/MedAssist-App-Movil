# ----------------------------------------------------------
# URL de la API del Backend (OBLIGATORIO en produccion)
# ----------------------------------------------------------
# Desarrollo web:
EXPO_PUBLIC_API_URL=http://localhost:8000

# Desarrollo Android (emulador):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Desarrollo iOS (simulador):
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Produccion (HTTPS obligatorio):
# EXPO_PUBLIC_API_URL=https://api.medassist.com
